{
  "name": "automation-ai-training",
  "version": "1.0.0",
  "description": "Professional Playwright TypeScript UI automation framework with POM, data-driven tests, Allure, and nightly CI",
  "main": "index.js",
  "scripts": {
    "pretest": "npm run clean",
    "test": "npx playwright test",
    "posttest": "npm run allure:generate",
    "clean": "rimraf allure-results allure-report test-results playwright-report",
    "clean:all": "npm run clean && rimraf coverage .nyc_output dist logs",
    "test:headed": "npx playwright test --headed",
    "test:chromium": "npx playwright test --project=chromium",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug",
    "codegen": "npx playwright codegen",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "coverage": "nyc --reporter=html --reporter=text --reporter=lcov --report-dir=coverage mocha --require ts-node/register 'tests/unit/**/*.spec.ts'",
    "coverage:check": "nyc check-coverage --lines 100 --functions 100 --branches 100 --statements 100",
    "test:unit": "mocha --require ts-node/register 'tests/unit/**/*.spec.ts'",
    "test:coverage": "npm run coverage && npm run coverage:check"
  },
  "keywords": [
    "playwright",
    "typescript",
    "allure",
    "page-object-model",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.2.0",
    "dotenv": "^16.4.7",
    "mocha": "^11.1.0",
    "nyc": "^17.1.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "include": [
      "utilities/**/*.ts",
      "pages/**/*.ts"
    ],
    "exclude": [
      "**/*.d.ts",
      "tests/**",
      "node_modules/**"
    ],
    "reporter": [
      "html",
      "text",
      "lcov"
    ],
    "all": true,
    "check-coverage": true,
    "lines": 100,
    "functions": 100,
    "branches": 100,
    "statements": 100
  }
}
